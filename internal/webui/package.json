{
  "name": "nono-hitl-webui",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:app && bun run build:theme",
    "build:app": "bun build src/main.tsx --outdir dist --entry-naming 'app.[ext]'",
    "build:theme": "bun build src/theme.ts --outdir dist --format iife"
  },
  "dependencies": {
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
