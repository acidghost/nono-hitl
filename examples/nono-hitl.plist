<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>nono-hitl</string>
    <key>ProgramArguments</key>
    <array>
        <string>/absolute/path/to/nono-hitl</string>
        <string>serve</string>
    </array>
    <key>StandardOutPath</key>
    <string>/absolute/path/to/nono-hitl.log</string>
    <key>StandardErrorPath</key>
    <string>/absolute/path/to/nono-hitl.error.log</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
