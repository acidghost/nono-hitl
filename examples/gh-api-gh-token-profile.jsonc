{
  "meta": {
    "name": "gh-api-gh-token",
    "version": "0.1.0",
    "description": "Mediate api.github.com using a host-side token captured from the official GitHub CLI"
  },
  "network": {
    "allow_domain": ["api.github.com"],
    "credentials": ["github"],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "cmd://github",
        "env_var": "GH_TOKEN",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    }
  },
  "credential_capture": {
    "github": {
      "command": [
        "/usr/bin/env",
        "-u",
        "GH_TOKEN",
        "-u",
        "GITHUB_TOKEN",
        "-u",
        "GH_ENTERPRISE_TOKEN",
        "-u",
        "GITHUB_ENTERPRISE_TOKEN",
        "gh",
        "auth",
        "token",
        "--hostname",
        "github.com"
      ],
      "timeout_secs": 15,
      "cache_ttl_secs": 900,
      "cache_path_regex": "^/repos/([^/]+)"
    }
  }
}
