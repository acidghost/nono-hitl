{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>acidghost/renovate-config",
    "local>acidghost/renovate-config:approve(patch)",
    "customManagers:biomeVersions"
  ],
  "packageRules": [
    {
      "matchDepNames": ["aqua:biomejs/biome"],
      "extractVersion": "@biomejs/biome@(?<version>.+)"
    }
  ]
}
